   "source": [
    "from pathlib import Path\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "ROOT = Path(\"C:/Users/suepp/Desktop/IT_Salary_Analysis\")\n",
    "RAW = ROOT / \"data\" / \"raw\" / \"it_salary.csv\"\n",
    "OUT = ROOT / \"data\" / \"processed\" / \"salary_clean.csv\"\n",
    "\n",
    "print(RAW, RAW.exists()),
    "OUT.parent.mkdir(parents=True, exist_ok=True),
    "\n",
    "log = []\n",
    "def note(step, n, detail=\"\"):\n",
    "    \"\"\"บันทึกขั้นตอนและจำนวนแถวที่ได้รับผลกระทบ\"\"\"\n",
    "    log.append({\"step\": step, \"rows_affected\": int(n), \"detail\": detail})\n",
    "\n",
    "df = pd.read_csv(RAW)\n",
    "note(\"rows read\", len(df))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "3b86f381",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. ตั้งชื่อคอลัมน์ใหม่ให้สั้นและเป็นรูปแบบเดียวกัน (เรียงตามไฟล์ต้นฉบับ)\n",
    "NEW_NAMES = [\n",
    "    \"age\", \"gender\", \"city\", \"position\", \"exp_total_years\",\n",
    "    \"exp_germany_years\", \"seniority\", \"main_tech\", \"other_tech\",\n",
    "    \"salary_eur\", \"bonus_eur\", \"salary_prev_year_eur\", \"bonus_prev_year_eur\",\n",
    "    \"vacation_days\", \"employment_status\", \"contract_duration\", \"work_language\",\n",
    "    \"company_size\", \"company_type\", \n",
    "]\n",
    "# ตรวจจำนวนคอลัมน์ก่อน ถ้าไม่ตรงจะบอกชัดเจนแทนที่จะ error งง ๆ\n",
    "if df.shape[1] != len(NEW_NAMES):\n",
    "    raise ValueError(f\"ไฟล์มี {df.shape[1]} คอลัมน์ แต่ในสคริปต์ตั้งชื่อไว้ {len(NEW_NAMES)} คอลัมน์ \"\n",
    "                     f\"-- ตรวจว่าลำดับคอลัมน์ในไฟล์ตรงกับ NEW_NAMES หรือไม่\\nคอลัมน์ในไฟล์: {list(df.columns)}\")\n",
    "df.columns = NEW_NAMES"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 38,
   "id": "a22c62b5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. ตัดช่องว่างหัวท้ายในคอลัมน์ข้อความ และเปลี่ยนข้อความว่างเป็นค่าว่าง (missing)\n",
    "for c in df.columns:\n",
    "    if pd.api.types.is_numeric_dtype(df[c]):\n",
    "        continue\n",
    "    df[c] = df[c].astype(\"string\").str.strip().replace(\"\", pd.NA)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "7d72d5b2",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. ลบแถวที่ซ้ำกันทุกคอลัมน์\n",
    "n = df.duplicated().sum()\n",
    "df = df.drop_duplicates()\n",
    "note(\"exact duplicate rows removed\", n)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "id": "ef3c9e67",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4. แปลงข้อความเป็นตัวเลข ค่าที่ไม่ใช่ตัวเลขจะกลายเป็นค่าว่าง (และบันทึกจำนวนไว้)\n",
    "num_cols = [\"exp_total_years\", \"exp_germany_years\", \"bonus_eur\", \"bonus_prev_year_eur\",\n",
    "            \"vacation_days\",]\n",
    "for c in num_cols:\n",
    "    before = df[c].notna().sum()\n",
    "    df[c] = pd.to_numeric(df[c], errors=\"coerce\")\n",
    "    note(f\"{c}: non-numeric text set to missing\", before - df[c].notna().sum())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "id": "4133280b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5. ค่าตัวเลขที่เป็นไปไม่ได้ -> ตั้งเป็นค่าว่าง (ไฟล์ดิบไม่ถูกแก้)\n",
    "rules = {  # คอลัมน์: (ค่าต่ำสุด, ค่าสูงสุด) -- เป็นข้อสมมติ ปรับได้ และต้องอธิบายเหตุผลใน README\n",
    "    \"salary_eur\": (10_000, 500_000),   # เงินเดือนหลัก: ค่าผิดปกติกลายเป็นค่าว่าง แล้วแถวถูกลบในขั้นที่ 8\n",
    "    \"age\": (18, 70),\n",
    "    \"exp_total_years\": (0, 50),\n",
    "    \"exp_germany_years\": (0, 50),\n",
    "    \"vacation_days\": (0, 60),\n",
    "    \"bonus_eur\": (0, 1_000_000),\n",
    "    \"bonus_prev_year_eur\": (0, 1_000_000),\n",
    "    \"salary_prev_year_eur\": (10_000, 500_000),\n",
    "}\n",
    "for c, (lo, hi) in rules.items():\n",
    "    bad = df[c].notna() & ~df[c].between(lo, hi)\n",
    "    df.loc[bad, c] = pd.NA\n",
    "    note(f\"{c}: outside {lo}-{hi} set to missing\", bad.sum())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 42,
   "id": "cfce9c59",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6. จัดหมวดหมู่ให้เป็นมาตรฐาน (คำตอบที่พบน้อยหรือแปลก -> 'Other' หรือค่าว่าง)\n",
    "def keep_top(s, keep, other=\"Other\"):\n",
    "    \"\"\"เก็บเฉพาะค่าที่กำหนดไว้ ค่าอื่นรวมเป็น 'Other' (ค่าว่างคงเดิม)\"\"\"\n",
    "    return s.where(s.isin(keep) | s.isna(), other)\n",
    " \n",
    "sen = df[\"seniority\"]\n",
    "df[\"seniority\"] = keep_top(sen, [\"Junior\", \"Middle\", \"Senior\", \"Lead\", \"Head\"])\n",
    "note(\"seniority: rare titles grouped as Other\", (df[\"seniority\"] == \"Other\").sum())\n",
    " \n",
    "emp = df[\"employment_status\"].str.lower()\n",
    "df[\"employment_status\"] = df[\"employment_status\"].where(\n",
    "    df[\"employment_status\"].isin([\"Full-time employee\", \"Self-employed (freelancer)\",\n",
    "                                  \"Part-time employee\", \"Founder\"]) | emp.isna(), \"Other\")\n",
    "df.loc[emp.isin([\"working student\", \"werkstudent\"]), \"employment_status\"] = \"Working student\"\n",
    "note(\"employment_status: free-text answers grouped\", (df[\"employment_status\"].isin([\"Other\", \"Working student\"])).sum())\n",
    " \n",
    "bad = df[\"contract_duration\"] == \"0\"\n",
    "df.loc[bad, \"contract_duration\"] = pd.NA\n",
    "note(\"contract_duration: invalid '0' set to missing\", bad.sum())\n",
    " \n",
    "df[\"work_language\"] = df[\"work_language\"].replace({\"Русский\": \"Russian\"})\n",
    "df[\"work_language\"] = keep_top(df[\"work_language\"], [\"English\", \"German\", \"Russian\"])\n",
    "note(\"work_language: grouped to English/German/Russian/Other\", (df[\"work_language\"] == \"Other\").sum())\n",
    " \n",
    "df[\"company_type\"] = keep_top(df[\"company_type\"],\n",
    "                              [\"Product\", \"Startup\", \"Consulting / Agency\"])\n",
    "note(\"company_type: grouped to top 3 + Other\", (df[\"company_type\"] == \"Other\").sum())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 43,
   "id": "04f901cc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 7. เมือง: ปรับการสะกดให้เหมือนกัน\n",
    "df[\"city\"] = df[\"city\"].str.title().replace({\"Düsseldorf\": \"Dusseldorf\"})\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 44,
   "id": "8e91fd56",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 8. ลบแถวที่ข้อมูลว่างในคอลัมน์สำคัญ\n",
    "KEY_COLS = [\"salary_eur\", \"age\", \"seniority\", \"exp_total_years\", \"city\"]\n",
    "n_before = len(df)\n",
    "for c in KEY_COLS:\n",
    "    note(f\"missing in key column '{c}'\", df[c].isna().sum())\n",
    "df = df.dropna(subset=KEY_COLS)\n",
    "note(\"rows dropped (missing in any key column)\", n_before - len(df))\n",
    "note(\"rows kept for analysis\", len(df))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 45,
   "id": "65e4555c",
   "metadata": {},
