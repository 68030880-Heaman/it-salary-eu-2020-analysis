     ]
    }
   ],
   "source": [
    "# 9. บันทึกผลลัพธ์\n",
    "df.to_csv(OUT, index=False)\n",
    "note(\"rows written\", len(df))\n",
    "print(pd.DataFrame(log).to_string(index=False))\n",
    "print(\"\\nsalary_eur:\")\n",
    "print(df[\"salary_eur\"].describe().round(0))\n"
   ]
  }
